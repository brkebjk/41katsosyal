# Bu dosyanın adını ".env" yap (başındaki nokta önemli) ve değerleri Supabase'den kopyala.
# Değerler: Supabase > Project Settings > API (Project URL ve "publishable" / anon anahtarı).

EXPO_PUBLIC_SUPABASE_URL=https://BURAYA-PROJE-ADRESI.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=BURAYA-PUBLISHABLE-ANAHTAR

# --- Premium satın alma (sonra, mağaza hesapları açılınca doldurulacak) ---
# RevenueCat panelinden alınan GENEL (public) anahtarlar. Boş bırakırsan Premium ekranında
# "Satın alma yakında açılacak" yazar; uygulamanın geri kalanı normal çalışır.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
