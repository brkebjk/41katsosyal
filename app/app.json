{
  "expo": {
    "name": "41. Kat Sosyal",
    "slug": "41kat",
    "scheme": "kat41",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF3F7",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF3F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kat41.app"
    },
    "android": {
      "package": "com.kat41.app",
      "adaptiveIcon": {
        "backgroundColor": "#071622",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF3F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071622",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "41. Kat Sosyal, gönderine yer eklerken yakınındaki mekânları listelemek ve bir oyuna girerken bulunduğun bölgeyi harita için bir kez almak üzere konumuna yalnızca uygulama açıkken bakar. Konumun sürekli takip edilmez ve tam konumun kaydedilmez.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "41. Kat Sosyal, moderatör mekân profil resmi seçerken galerine erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cihaz dosyalarınız bizi ilgilendirmiyor. Kişi gerçekliğini maksimize etmek ve küçük yaşta kullanıcıların önüne geçmek için profil fotoğrafı eklemek için sadece kameranı kullanabilirsin.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFB020"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "41. Kat Sosyal, arkadaşını davet ederken rehberinden seçtiğin kişiye hazır davet mesajı göndermek için rehberine erişir. Rehberin sunucuya gönderilmez."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
